{
  "name": "kitsch-automation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Kitsch QA automation suite \u2014 locale parity (content + render), web specs, mobile smoke",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ad-landing:fixture": "tsx fixtures/ad-landing/server.ts",
    "audit:ad-landing": "tsx tools/ad-landing-audit.ts",
    "audit:compare-at": "tsx tools/compare-at-audit.ts",
    "audit:top-products": "tsx tools/top-products-audit.ts",
    "compare-at:fixture": "tsx fixtures/compare-at/server.ts",
    "i18n:parity": "tsx i18n/run-parity.ts",
    "lint": "eslint .",
    "parity:clean": "tsx i18n/run-parity.ts --catalog fixtures/catalog/catalog-clean.json --out i18n-report/clean --gate",
    "preflight": "tsx tools/preflight.ts",
    "resolve:handles": "tsx tools/resolve-handles.ts",
    "review": "tsx tools/review/run-review.ts",
    "storefront": "tsx fixtures/storefront/server.ts",
    "test:ad-landing-detection": "tsx tools/verify-ad-landing.ts",
    "test:app": "maestro test mobile/maestro/",
    "test:compare-at-detection": "tsx tools/verify-compare-at.ts",
    "test:debug": "playwright test --debug",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:desktop:all": "playwright test --project=desktop-chrome --project=desktop-firefox --project=desktop-safari",
    "test:desktop:edge": "playwright test --project=desktop-edge",
    "test:desktop:firefox": "playwright test --project=desktop-firefox",
    "test:desktop:headed": "playwright test --project=desktop-chrome --headed",
    "test:desktop:safari": "playwright test --project=desktop-safari",
    "test:detection": "tsx i18n/verify-detection.ts",
    "test:i18n": "playwright test --project=i18n-mobile",
    "test:kits": "playwright test --project=mobile-chrome --grep @kits",
    "test:mobile-web": "playwright test --project=mobile-chrome",
    "test:top-products-detection": "tsx tools/verify-top-products.ts",
    "test:ui": "playwright test --ui",
    "test:unit": "node --import tsx --test \"i18n/lib/*.test.ts\" \"web/lib/*.test.ts\" \"tools/review/*.test.ts\" \"tools/lib/*.test.ts\"",
    "top-products:fixture": "tsx fixtures/top-products/server.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run review -- --gate && npm run test:unit && npm run parity:clean && npm run test:i18n && npm run test:kits && npm run test:detection && npm run test:compare-at-detection && npm run test:top-products-detection && npm run test:ad-landing-detection"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "yaml": "^2.9.0"
  }
}
