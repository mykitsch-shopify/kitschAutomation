{
  "name": "kitsch-automation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Kitsch QA automation suite — locale parity (content + render), web specs, mobile smoke",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "a11y:daily": "tsx tools/a11y-audit.ts",
    "a11y:fixture": "tsx fixtures/a11y/server.ts",
    "ad-landing:fixture": "tsx fixtures/ad-landing/server.ts",
    "asana:close": "tsx tools/asana-close.ts",
    "asana:doctor": "tsx tools/asana-doctor.ts",
    "asana:pull": "tsx tools/asana-pull.ts",
    "asana:reopen": "tsx tools/asana-reopen.ts",
    "audit:a11y": "tsx tools/a11y-audit.ts",
    "audit:ad-landing": "tsx tools/ad-landing-audit.ts",
    "audit:compare-at": "tsx tools/compare-at-audit.ts",
    "audit:health-check": "tsx tools/health-check-audit.ts",
    "audit:top-products": "tsx tools/top-products-audit.ts",
    "audit:translation-backlog": "tsx tools/translation-backlog-audit.ts",
    "brief": "tsx tools/render-brief.ts",
    "ci:offline": "npm run precommit && npm run parity:clean && npm run test:i18n && npm run test:kits && npm run test:kits-detection && npm run test:detection && npm run test:compare-at-detection && npm run test:top-products-detection && npm run test:ad-landing-detection && npm run test:translation-backlog-detection && npm run test:a11y-detection && npm run test:health-check-detection",
    "compare-at:fixture": "tsx fixtures/compare-at/server.ts",
    "daily": "tsx tools/daily.ts",
    "gate:release": "tsx tools/release-gate.ts",
    "health-check:fixture": "tsx fixtures/health-check/server.ts",
    "hooks:install": "tsx tools/install-hooks.ts",
    "i18n:parity": "tsx i18n/run-parity.ts",
    "lint": "eslint .",
    "parity:clean": "tsx i18n/run-parity.ts --catalog fixtures/catalog/catalog-clean.json --out i18n-report/clean --gate",
    "precommit": "tsx tools/precommit.ts",
    "preflight": "tsx tools/preflight.ts",
    "prepare": "tsx tools/install-hooks.ts || true",
    "report": "tsx tools/allure-report.ts",
    "report:clean": "tsx tools/report-clean.ts",
    "report:open": "allure open allure-report",
    "resolve:handles": "tsx tools/resolve-handles.ts",
    "review": "tsx tools/review/run-review.ts",
    "storefront": "tsx fixtures/storefront/server.ts",
    "test:a11y-detection": "tsx tools/verify-a11y.ts",
    "test:ad-landing-detection": "tsx tools/verify-ad-landing.ts",
    "test:app": "maestro test mobile/maestro/",
    "test:compare-at-detection": "tsx tools/verify-compare-at.ts",
    "test:debug": "playwright test --debug",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:desktop:all": "playwright test --project=desktop-chrome --project=desktop-firefox --project=desktop-safari",
    "test:desktop:edge": "playwright test --project=desktop-edge",
    "test:desktop:firefox": "playwright test --project=desktop-firefox",
    "test:desktop:headed": "playwright test --project=desktop-chrome --headed",
    "test:desktop:safari": "playwright test --project=desktop-safari",
    "test:detection": "tsx i18n/verify-detection.ts",
    "test:health-check-detection": "tsx tools/verify-health-check.ts",
    "test:i18n": "playwright test --project=i18n-mobile",
    "test:kits": "playwright test --project=mobile-chrome --grep @kits",
    "test:kits-detection": "tsx tools/verify-kit-parity.ts",
    "test:mobile-web": "playwright test --project=mobile-chrome",
    "test:top-products-detection": "tsx tools/verify-top-products.ts",
    "test:translation-backlog-detection": "tsx tools/verify-translation-backlog.ts",
    "test:ui": "playwright test --ui",
    "test:unit": "node --import tsx --test \"i18n/lib/*.test.ts\" \"web/lib/*.test.ts\" \"visual/lib/*.test.ts\" \"tools/review/*.test.ts\" \"tools/lib/*.test.ts\"",
    "top-products:fixture": "tsx fixtures/top-products/server.ts",
    "translation-backlog:fixture": "tsx fixtures/translation-backlog/server.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run review -- --gate && npm run test:unit && npm run parity:clean && npm run test:i18n && npm run test:kits && npm run test:kits-detection && npm run visual && npm run visual:detection && npm run test:detection && npm run test:compare-at-detection && npm run test:top-products-detection && npm run test:ad-landing-detection && npm run test:translation-backlog-detection && npm run test:a11y-detection && npm run test:health-check-detection",
    "visual": "playwright test --project=visual",
    "visual:bless": "playwright test --project=visual --update-snapshots",
    "visual:detection": "tsx tools/verify-visual.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^22.10.0",
    "allure": "^3.16.0",
    "allure-js-commons": "^3.11.0",
    "allure-playwright": "^3.11.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "yaml": "^2.9.0"
  }
}
