{
  // Use the workspace TypeScript, not the one bundled with the editor — the
  // repo pins 6.0.3 and the type-aware lint rules depend on it.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Where the unit tests live. Must stay in step with the test:unit script in
  // package.json; tools/lib/ci-parity.test.ts holds the two together, because a
  // Test Explorer that silently stops listing a directory looks exactly like a
  // directory with no tests in it.
  "nodejs-testing.include": [
    "i18n/lib",
    "web/lib",
    "visual/lib",
    "tools/lib",
    "tools/review"
  ],
  "nodejs-testing.extensions": [
    { "extensions": ["ts"], "parameters": ["--import", "tsx"] }
  ],

  "eslint.useFlatConfig": true,
  "eslint.validate": ["typescript", "javascript"],

  "files.exclude": {
    "**/test-results": true,
    "**/playwright-report": true,
    "**/blob-report": true,
    "**/i18n-report": true,
    "**/review-report": true
  },

  // The generated catalogues are build output; edit fixtures/catalog/content.ts
  // and regenerate instead.
  "files.readonlyInclude": {
    "fixtures/catalog/catalog-clean.json": true,
    "fixtures/catalog/catalog-seeded.json": true
  }
}
